programa {


    funcao real media3Valores(real a , real  b , real c){
        real resultado = (a + b + c)  / 3
    
         retorne resultado 

    }

    // real a,b,c - Variaval Global



    funcao inicio() {

        real aluno1 = 0.0
        real aluno2 = 0.0
        real aluno3 = 0.0


        aluno1 = media3Valores  (7.5,8.1,3.7)
        aluno2 = media3Valores  (7.0,8.1,3.7)
        aluno3 = media3Valores  (7.0,8.1,3.7)

        escreva("Media aluno 1: ", aluno1, "\n")
        escreva("Media aluno 2: ", aluno2, "\n")
        escreva("Media aluno 3: ", aluno3, "\n")





        
    }
}
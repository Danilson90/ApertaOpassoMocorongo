// Problema A — Secretaria Acadêmica
programa
{
	funcao inicio()
	{
		inteiro opcao
		real media
		inteiro horas

		opcao = -1

		enquanto (opcao != 0)
		{
			escreva("\n===== SECRETARIA ACADEMICA =====\n")
			escreva("1 - Classificar media do candidato\n")
			escreva("2 - Classificar horas de ausencia\n")
			escreva("0 - Sair\n")
			escreva("Escolha uma opcao: ")
			leia(opcao)
    }

  }
}